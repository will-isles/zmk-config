#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Base layer (Layer 0): Default QWERTY layout

        Base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESCAPE  &kp Q  &kp W  &kp E         &kp R  &kp T         &kp Y      &kp U  &kp I          &kp O    &kp P     &kp BSPC
&kp TAB     &kp A  &kp S  &kp D         &kp F  &kp G         &kp H      &kp J  &kp K          &kp L    &kp SEMI  &kp APOS
&kp LCTRL   &kp Z  &kp X  &kp C         &kp V  &kp B         &kp N      &kp M  &kp COMMA      &kp DOT  &kp FSLH  &kp ENTER
                          &kp LEFT_GUI  &mo 1  &kp LSHIFT    &kp SPACE  &mo 2  &kp RIGHT_ALT
            >;
        };

        // Lower layer (Layer 1): Numbers, symbols, and navigation keys
        // Activated by holding the left thumb key (LWR) in Base layer

        Lower {
            bindings = <
&kp GRAVE  &trans           &kp N7        &kp N8        &kp N9        &kp MINUS     &trans          &trans    &trans        &trans     &trans      &trans
&trans     &trans           &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp EQUAL     &kp PG_UP       &kp HOME  &kp UP_ARROW  &kp END    &kp INSERT  &kp DELETE
&trans     &kp KP_NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD    &kp PAGE_DOWN   &kp LEFT  &kp DOWN      &kp RIGHT  &trans      &trans
                                          &trans        &trans        &trans        &kp LEFT_SHIFT  &trans    &trans
            >;
        };

        // Raise layer (Layer 2): Function keys and Bluetooth controls
        // Activated by holding the right thumb key (RSE) in Base layer

        Raise {
            bindings = <
&kp F1  &kp F2         &kp F3          &kp F4            &kp F5                &kp F6           &kp F7     &kp F8                 &kp F9           &kp F10           &kp F11  &kp F12
&trans  &kp LESS_THAN  &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp BACKSLASH    &kp SLASH  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp GREATER_THAN  &trans   &trans
&trans  &trans         &trans          &trans            &trans                &kp PIPE         &trans     &trans                 &trans           &trans            &trans   &trans
                                       &trans            &kp LALT              &trans           &trans     &trans                 &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
